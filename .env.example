# Stellar Network (TESTNET or PUBLIC)
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Loyalty Token (Classic Asset)
NEXT_PUBLIC_LOYALTY_CODE=ENTER_YOUR_TOKEN_CODE_HERE
NEXT_PUBLIC_LOYALTY_ISSUER=ENTER_YOUR_TESTNET_ISSUER_PUBLIC_KEY_HERE

# Vite (this project)
VITE_STELLAR_NETWORK=TESTNET
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_LOYALTY_CODE=ENTER_YOUR_TOKEN_CODE_HERE
VITE_LOYALTY_ISSUER=ENTER_YOUR_TESTNET_ISSUER_PUBLIC_KEY_HERE
# El servidor (Vercel) también lee estos nombres:
LOYALTY_CODE=ENTER_YOUR_TOKEN_CODE_HERE
LOYALTY_ISSUER=ENTER_YOUR_TESTNET_ISSUER_PUBLIC_KEY_HERE

# Secret Key for Fee Bump / Sponsored Transactions (Backend only - NEVER expose on client)
SPONSOR_SECRET_KEY=ENTER_YOUR_SPONSOR_SECRET_KEY_HERE

# Super admin (cuenta distribuidor). En local y en el deploy de Vercel
# se crea/actualiza sola: admin@stellarpay.local / Admin1234!
# Desactivar: SUPER_ADMIN_SEED=false
SUPER_ADMIN_PUBLIC_KEY=GC5IQE74UCRCKXJII3G3AYNJHB75JGVD2TQKMDNNR2QZVLKEDVU5E4NJ
SUPER_ADMIN_EMAIL=admin@stellarpay.local

# Staff del evento (se crean solas en local). Cambia las contraseñas en el deploy.
# Caja:  caja@stellarpay.local / CajaRojo#16Sep26
# SINPE: sinpe@stellarpay.local / SinpeMatch#16Sep26
# Desactivar: STAFF_SEED=false
# CASHIER_EMAIL=caja@stellarpay.local
# CASHIER_PASSWORD=
# SINPE_OPS_EMAIL=sinpe@stellarpay.local
# SINPE_OPS_PASSWORD=


# SEP-24 on-ramp (Testnet). Keep the SDF test anchor for local/dev:
# it simulates cash (MoneyGram-style) and card without allowlisting.
# MoneyGram Access sandbox requires allowlist: extmgxanchor.moneygram.com
SEP24_HOME_DOMAIN=testanchor.stellar.org
# Circle USDC on Testnet (stellar.toml of testanchor). Do not use a mistyped issuer.
VITE_USDC_CODE=USDC
VITE_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Opcional: firma extra de client_domain (wallets no custodiales / allowlist)
# SEP24_CLIENT_DOMAIN=
# SEP24_CLIENT_SIGNING_SECRET=

# Mapa: tiles oscuros de Esri (sin API key). No hace falta VITE_MAP_STYLE_URL.

# Login / registro con Google (cliente y empresa).
# Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web).
# Orígenes autorizados: http://localhost:5173 y la URL de Vercel.
GOOGLE_CLIENT_ID=
# Opcional, mismo valor, si quieres leerlo también en el frontend:
# VITE_GOOGLE_CLIENT_ID=

# Obligatorio en Vercel (Storage → Create Database → KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Virtual Visa (sandbox). El frontend siempre llama /api/cards/*.
# CARD_TREASURY_SECRET_KEY=   # opcional; si falta, el servidor crea tesorería en Testnet
# CARD_DAILY_LIMIT_USD=500
# CARD_PROVIDER=sandbox       # pon `rain` solo cuando el adaptador de producción esté listo
# RAIN_API_KEY=
# RAIN_API_BASE_URL=https://api.raincards.xyz

# --- Facturación electrónica Costa Rica (Cyberfuel sandbox) ---
# Documentación pública: https://www.comprobanteselectronicoscr.com/doc-api.html
# MakeXML sandbox: https://www.comprobanteselectronicoscr.com/api/makeXML.stag.42
NODE_ENV=development
CYBERFUEL_API_URL=https://www.comprobanteselectronicoscr.com/api
CYBERFUEL_API_KEY=tu_api_key_de_pruebas
# CYBERFUEL_BEARER_TOKEN=
CYBERFUEL_ENV=stag
# 42 = estructura documentada públicamente. Cambia a 44 si tu cuenta ya usa DGT 4.4.
CYBERFUEL_STRUCTURE_VERSION=42
CYBERFUEL_SUCURSAL=1
CYBERFUEL_TERMINAL=1
CYBERFUEL_SITUACION_PRESENTACION=1
# 99 = Otros (cobro cripto on-chain). 04 = transferencia.
CYBERFUEL_MEDIO_PAGO=99

# Datos del emisor (tal como están en ATV / Cyberfuel)
EMISOR_NOMBRE=Tu Razón Social S.A.
EMISOR_NOMBRE_COMERCIAL=Stellar Pay
EMISOR_TIPO_IDENTIFICACION=02
EMISOR_NUMERO=3101123456
EMISOR_PROVINCIA=1
EMISOR_CANTON=01
EMISOR_DISTRITO=01
EMISOR_BARRIO=01
EMISOR_SENNAS=San José, Costa Rica
EMISOR_TELEFONO=22222222
EMISOR_CORREO=facturacion@tuempresa.com

# Tipo de cambio venta CRC/USD (Hacienda/BCCR). Override numérico para tests:
EXCHANGE_RATE_API_URL=https://api.hacienda.go.cr/indicadores/tc/dolar
# EXCHANGE_RATE_USD_CRC=453.38

# Listener Horizon (Testnet) y webhook
INVOICE_MERCHANT_WALLET=
INVOICE_WEBHOOK_SECRET=cambia_este_secreto
INVOICE_DEFAULT_CABYS=
INVOICE_DEFAULT_DESCRIPTION=Servicio digital cobrado en criptomoneda (Stellar Testnet)
INVOICE_TAX_RATE=13
INVOICE_USD_ASSETS=USDC,USD
# HORIZON_URL=https://horizon-testnet.stellar.org

# Recargas SINPE Móvil (SMS webhook). Paridad: ₡1,000 = 1 ROJO. Promo ₡9,000 = 10 ROJOS.
# Inventa esta clave y pon LA MISMA en SMS Forwarder → Header X-API-KEY.
SINPE_SMS_API_KEY=sinpe_local_dev_key
# Número al que el cliente envía el SINPE (se muestra y se copia en la app).
SINPE_RECEIVE_PHONE=88880000
# Opcional: secreto para firmar el código sc…ts. Si falta, usa SESSION_SECRET.
# SINPE_CODE_SECRET=
# Secret key S... de la cuenta que tiene ROJOS y los paga al usuario (nunca en el cliente)
SINPE_TREASURY_SECRET_KEY=ENTER_YOUR_ROJOS_DISTRIBUTOR_SECRET_KEY_HERE

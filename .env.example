# Stellar Network (TESTNET or PUBLIC)
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Loyalty Token (Classic Asset)
NEXT_PUBLIC_LOYALTY_CODE=ENTER_YOUR_TOKEN_CODE_HERE
NEXT_PUBLIC_LOYALTY_ISSUER=ENTER_YOUR_TESTNET_ISSUER_PUBLIC_KEY_HERE

# Vite (this project)
VITE_STELLAR_NETWORK=TESTNET
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_LOYALTY_CODE=ENTER_YOUR_TOKEN_CODE_HERE
VITE_LOYALTY_ISSUER=ENTER_YOUR_TESTNET_ISSUER_PUBLIC_KEY_HERE
# El servidor (Vercel) también lee estos nombres:
LOYALTY_CODE=ENTER_YOUR_TOKEN_CODE_HERE
LOYALTY_ISSUER=ENTER_YOUR_TESTNET_ISSUER_PUBLIC_KEY_HERE

# Secret Key for Fee Bump / Sponsored Transactions (Backend only - NEVER expose on client)
SPONSOR_SECRET_KEY=ENTER_YOUR_SPONSOR_SECRET_KEY_HERE

# Super admin (cuenta distribuidor). En local y en el deploy de Vercel
# se crea/actualiza sola: admin@stellarpay.local / Admin1234!
# Desactivar: SUPER_ADMIN_SEED=false
SUPER_ADMIN_PUBLIC_KEY=GC5IQE74UCRCKXJII3G3AYNJHB75JGVD2TQKMDNNR2QZVLKEDVU5E4NJ
SUPER_ADMIN_EMAIL=admin@stellarpay.local


# SEP-24 on-ramp (Testnet). Keep the SDF test anchor for local/dev:
# it simulates cash (MoneyGram-style) and card without allowlisting.
# MoneyGram Access sandbox requires allowlist: extmgxanchor.moneygram.com
SEP24_HOME_DOMAIN=testanchor.stellar.org
# Circle USDC on Testnet (stellar.toml of testanchor). Do not use a mistyped issuer.
VITE_USDC_CODE=USDC
VITE_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Opcional: firma extra de client_domain (wallets no custodiales / allowlist)
# SEP24_CLIENT_DOMAIN=
# SEP24_CLIENT_SIGNING_SECRET=

# Mapa: tiles oscuros de Esri (sin API key). No hace falta VITE_MAP_STYLE_URL.

# Obligatorio en Vercel (Storage → Create Database → KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Virtual Visa (sandbox). El frontend siempre llama /api/cards/*.
# CARD_TREASURY_SECRET_KEY=   # opcional; si falta, el servidor crea tesorería en Testnet
# CARD_DAILY_LIMIT_USD=500
# CARD_PROVIDER=sandbox       # pon `rain` solo cuando el adaptador de producción esté listo
# RAIN_API_KEY=
# RAIN_API_BASE_URL=https://api.raincards.xyz

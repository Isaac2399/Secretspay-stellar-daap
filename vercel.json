{
  "framework": "vite",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/:path*" },
    { "source": "/api/events/orders/ready", "destination": "/api/events/ready" },
    { "source": "/api/events/orders/complete", "destination": "/api/events/complete" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
